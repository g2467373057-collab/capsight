# ───────────────────────── Capsight API · 配置模板 ─────────────────────────
# 复制为 .env 后填写。带 * 的是上线必填。

# ---- 基础 ----
NODE_ENV=production
PORT=8787
# * 前端网站的地址（用于邮件里的链接和跨域白名单）
APP_URL=https://capsight.example.com
# 允许调用 API 的前端地址，多个用逗号分隔（默认等于 APP_URL）
# ALLOWED_ORIGINS=https://capsight.example.com
# 部署在 Nginx / Caddy 等反向代理后面时设为 1，才能拿到用户真实 IP
TRUST_PROXY=1
DB_PATH=./data/capsight.db

# ---- 账号 ----
REQUIRE_EMAIL_VERIFICATION=true
# 前端和 API 在不同主域名时改为 None（同时必须 HTTPS）
COOKIE_SAMESITE=Lax
SESSION_DAYS=30

# ---- 免费额度与成本控制 ----
RUNS_PER_USER_PER_DAY=3
# 不受每日次数限制的账号（你自己测试用），多个用逗号分隔
ADMIN_EMAILS=
RUNS_PER_DAY_GLOBAL=500
MAX_COMPETITORS=5
RUN_CONCURRENCY=3
MAX_REQUERY=2
CACHE_HOURS=12

# ---- 大模型：deepseek | qwen | qwen-intl | openai | anthropic ----
# * 默认（中英文都用）
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# 可选：英文用户单独用 Claude
# LLM_PROVIDER_EN=anthropic
# ANTHROPIC_API_KEY=
# LLM_MODEL_EN=claude-haiku-5-5
# 可选：中文用户单独用通义千问
# LLM_PROVIDER_ZH=qwen
# DASHSCOPE_API_KEY=
# OPENAI_API_KEY=
# LLM_MODEL=deepseek-flash

# ---- 搜索：serper（Google 结果，海外） | bocha（博查，国内） ----
SEARCH_PROVIDER_EN=serper
SEARCH_PROVIDER_ZH=bocha
# * 至少填一个
SERPER_API_KEY=
BOCHA_API_KEY=

# ---- 新闻（按顺序尝试）：googlenews | gdelt | bocha | serper ----
NEWS_PROVIDERS_EN=googlenews,gdelt
NEWS_PROVIDERS_ZH=bocha,gdelt

# ---- 社媒官方 API（不填就只记录账号链接） ----
# X API v2 Bearer Token（按读取量计费）
X_BEARER_TOKEN=
# Set to false to skip paid X API calls without deleting the token
X_ENABLED=true
X_MAX_POSTS=5
# YouTube Data API v3
YOUTUBE_API_KEY=
# Reddit（https://www.reddit.com/prefs/apps 创建应用）
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=web:capsight:v1.0 (by /u/你的用户名)

# ---- 发信（邮箱验证、找回密码）：Resend ----
RESEND_API_KEY=
MAIL_FROM=Capsight <noreply@capsight.example.com>

# ---- 抓取 ----
FETCH_RESPECT_ROBOTS=true
FETCH_TIMEOUT_MS=12000
# 需要渲染才有内容的网站：设为 jina 使用 Jina Reader（可选 JINA_API_KEY）
READER=none
# JINA_API_KEY=
